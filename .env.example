# Nuxt Studio (GitHub OAuth app for /admin)
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
STUDIO_GITHUB_MODERATORS=

# Release backend (tauri-updater-backend module, served under /apps and /__updater-admin). Runtime only; never needed
# at build time. The database must live outside the deploy (Turso/libSQL URL), or it is lost on every redeploy.
NUXT_TAURI_UPDATER_DATABASE_OPTIONS_URL=
NUXT_TAURI_UPDATER_DATABASE_OPTIONS_AUTH_TOKEN=
NUXT_TAURI_UPDATER_S3_ENDPOINT=
NUXT_TAURI_UPDATER_S3_REGION=
NUXT_TAURI_UPDATER_S3_BUCKET=
NUXT_TAURI_UPDATER_S3_ACCESS_KEY_ID=
NUXT_TAURI_UPDATER_S3_SECRET_ACCESS_KEY=
# Admin UI login fallback (Authorization: Bearer). Long random string; leave empty to keep the admin closed.
NUXT_TAURI_UPDATER_ADMIN_TOKEN=

# Nuxt Studio (GitHub OAuth app for /admin)
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
STUDIO_GITHUB_MODERATORS=

# Apps release backend (layers/apps, served under /apps). Read at runtime; never needed at build time.
NUXT_APPS_S3_ENDPOINT=
NUXT_APPS_S3_REGION=
NUXT_APPS_S3_BUCKET=
NUXT_APPS_S3_ACCESS_KEY_ID=
NUXT_APPS_S3_SECRET_ACCESS_KEY=
